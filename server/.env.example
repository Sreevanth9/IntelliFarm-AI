PORT=5001
NODE_ENV=development
ACCESS_TOKEN_JWT_SECRET=replace_with_a_unique_32_character_minimum_access_secret
REFRESH_TOKEN_JWT_SECRET=replace_with_a_different_unique_32_character_minimum_refresh_secret
ACCESS_TOKEN_EXPIRETIME=15m
REFRESH_TOKEN_EXPIRETIME=7d
JWT_ISSUER=intellifarm-api
JWT_AUDIENCE=intellifarm-web
GROQ_API_KEY=your_groq_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
SUPABASE_URL=https://your-supabase-project.supabase.co
# Server-only Supabase secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SECRET_KEY=your_server_only_supabase_secret_key
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
SUPPORT_RECIPIENT_EMAIL=your_support_email@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
