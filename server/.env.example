PORT=5001
NODE_ENV=development
ACCESS_TOKEN_JWT_SECRET=replace_with_a_unique_32_character_minimum_access_secret
REFRESH_TOKEN_JWT_SECRET=replace_with_a_different_unique_32_character_minimum_refresh_secret
ACCESS_TOKEN_EXPIRETIME=15m
REFRESH_TOKEN_EXPIRETIME=7d
JWT_ISSUER=intellifarm-api
JWT_AUDIENCE=intellifarm-web
GROQ_API_KEY=your_groq_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_supabase_secret_key
CLIENT_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# AWS Cloud Configuration (Amazon S3, IAM, CloudFront)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=intellifarm-storage
AWS_CLOUDFRONT_DOMAIN=d12345abcdef.cloudfront.net
